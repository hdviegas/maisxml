APP_NAME="Mais XML"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

# Legacy MySQL table for login (default: usuario). Set if your dump uses another name.
# LEGACY_USUARIO_TABLE=usuario

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Stack Docker (MySQL + Redis + Nginx): copie docker/env.docker.example para .env — ver docs/DOCKER.md

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Segundos para cache dos totais do painel (consultas pesadas). 0 = sem cache (útil em testes).
# DASHBOARD_STATS_CACHE_TTL=180

# Dias de emissão (data_nf) no resumo padrão do painel e teto do intervalo (ver config/dashboard.php).
# DASHBOARD_DEFAULT_PERIOD_DAYS=7
# DASHBOARD_MAX_PERIOD_DAYS=366

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ingestão máquina POST /api/v1/ingest/xml (substitui recepcao.php). Pelo menos um obrigatório em produção.
INGEST_TOKEN=
INGEST_HMAC_SECRET=
INGEST_RATE_LIMIT=120

# SIEG (docs/SIEG_INTEGRACAO.md). A API Key NÃO vai aqui: use `php artisan sieg:account`.
SIEG_BASE_URL=https://api.sieg.com
SIEG_SCHEDULE_ENABLED=false
SIEG_SCHEDULE_CRON="*/10 * * * *"
SIEG_SYNC_MAX_RUNTIME=240
# Limites por minuto (documentados: baixar-xmls 2, contar-xmls 5, nsu 3000)
SIEG_RL_BAIXAR_XMLS=2
SIEG_RL_NSU_LOTE=60

# Raiz do disco "local" onde ficam os XMLs (colunas xml.url = "xml/..." e "xml_entrada/...").
# Padrão: storage/app/private. Na Locaweb, aponte para a pasta que contém xml/ e xml_entrada/
# do sistema antigo (sem barra final). Ex.: /home/SEU_USUARIO/public_html
# Aceita caminho relativo ao projeto (ex.: .. = pasta pai) ou absoluto.
# FILESYSTEM_LOCAL_ROOT=..
