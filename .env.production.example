# Modelo para produção (Locaweb). Copie para .env no servidor e preencha.
# NUNCA versione o .env real. Depois: php artisan key:generate (ou defina APP_KEY),
# php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME="Mais XML"
APP_ENV=production
# Gere com: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Projeto inteiro dentro de public_html/admin (sem mudar o document root).
APP_URL=https://SEU_DOMINIO/admin
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Banco MySQL da hospedagem
DB_CONNECTION=mysql
DB_HOST=SEU_HOST_MYSQL
DB_PORT=3306
DB_DATABASE=SEU_BANCO
DB_USERNAME=SEU_USUARIO_DB
DB_PASSWORD=SUA_SENHA_DB

# Tabela legada de login (só defina se o dump usar outro nome)
# LEGACY_USUARIO_TABLE=usuario

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# O domínio raiz roda o sistema antigo com seus próprios cookies; isola o cookie do Laravel em /admin.
SESSION_PATH=/admin
CACHE_STORE=file
# Hospedagem compartilhada não mantém worker: processa filas na hora.
QUEUE_CONNECTION=sync

# Raiz dos XMLs. Layout na Locaweb:
#   public_html/admin/        <- este projeto Laravel inteiro (app, vendor, .env, public...)
#   public_html/xml/          <- XMLs de saída (xml.url = xml/{cnpj}/{mm-aa}/{chave}-NFe.xml)
#   public_html/xml_entrada/  <- XMLs de entrada
# Caminho relativo é resolvido a partir da pasta do projeto: ".." = public_html.
# Também aceita caminho absoluto (ex.: /home/SEU_USUARIO/public_html).
FILESYSTEM_LOCAL_ROOT=..

# Ingestão POST /api/v1/ingest/xml: defina pelo menos um dos dois.
INGEST_TOKEN=TROQUE_POR_TOKEN_LONGO_ALEATORIO
# INGEST_HMAC_SECRET=
INGEST_RATE_LIMIT=120

# SIEG: o agendador exige cron no painel da Locaweb (php artisan schedule:run a cada minuto).
SIEG_SCHEDULE_ENABLED=false

MAIL_MAILER=smtp
MAIL_HOST=SEU_SMTP
MAIL_PORT=587
MAIL_USERNAME=SEU_USUARIO_SMTP
MAIL_PASSWORD=SUA_SENHA_SMTP
MAIL_FROM_ADDRESS="no-reply@SEU_DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"
