# Copy to project root as `.env` when using Docker Compose (see docs/DOCKER.md).
# Values below match docker-compose.yml defaults.

APP_NAME="Mais XML"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Containers (`app`, `worker`) use these values as-is. For the bundled MySQL service, use the
# Compose network hostname `mysql` and port `3306`. Do not set `DB_HOST=127.0.0.1` here — from
# inside a container that points at the app itself, not the host or `mysql`.
# Run Artisan inside the stack: `docker compose exec app php artisan …`
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=maisxml
DB_USERNAME=maisxml
DB_PASSWORD=maisxml
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Machine ingest (local dev)
INGEST_TOKEN=dev-ingest-token
INGEST_RATE_LIMIT=120

# Vite / assets: build on host (`npm run build`) or use node image — see docs/DOCKER.md
